{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# GPTimage1.5 画像生成・画像編集",
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. セットアップ"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!pip -q install --upgrade openai pillow streamlit requests\n",
        "!wget -q https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-amd64 -O /usr/local/bin/cloudflared\n",
        "!chmod +x /usr/local/bin/cloudflared\n",
        "!which cloudflared && cloudflared --version"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. APIキー設定"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import os\n",
        "from getpass import getpass\n",
        "\n",
        "if not os.environ.get(\"OPENAI_API_KEY\"):\n",
        "    os.environ[\"OPENAI_API_KEY\"] = getpass(\"OpenAI API Keyを入力してください: \")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from openai import OpenAI\n",
        "\n",
        "client = OpenAI(api_key=os.environ[\"OPENAI_API_KEY\"])\n",
        "print(\"OpenAI client ready\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. 画像生成"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "import base64\n",
        "import io\n",
        "from PIL import Image\n",
        "\n",
        "prompt = \"a white siamese cat, highly detailed, soft natural lighting\"\n",
        "\n",
        "response = client.images.generate(\n",
        "    model=\"gpt-image-1.5\",\n",
        "    prompt=prompt,\n",
        "    size=\"1024x1024\"\n",
        ")\n",
        "\n",
        "image_base64 = response.data[0].b64_json\n",
        "image_bytes = base64.b64decode(image_base64)\n",
        "image = Image.open(io.BytesIO(image_bytes))\n",
        "\n",
        "image.save(\"generated_image.png\")\n",
        "image"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. 画像編集（マスクあり）\n",
        "\n",
        "事前に `image_name` と `mask_name` の画像を Colab にアップロードしてから実行してください。"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from google.colab import files\n",
        "\n",
        "uploaded = files.upload()\n",
        "print(\"uploaded files:\", list(uploaded.keys()))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "image_name = \"8044547720_628e930721_z.png\"          # 元画像ファイル名に変更\n",
        "mask_name = \"8044547720_628e930721_z_mask_1.png\"   # マスク画像ファイル名に変更\n",
        "\n",
        "original = Image.open(image_name)\n",
        "mask = Image.open(mask_name)\n",
        "\n",
        "display(original), display(mask)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "edit_prompt = \"羊を消して、自然な背景で違和感なく補完して\"\n",
        "\n",
        "with open(image_name, \"rb\") as image_file, open(mask_name, \"rb\") as mask_file:\n",
        "    response = client.images.edit(\n",
        "        model=\"gpt-image-1.5\",\n",
        "        image=image_file,\n",
        "        mask=mask_file,\n",
        "        prompt=edit_prompt,\n",
        "        size=\"1024x1024\"\n",
        "    )\n",
        "\n",
        "edited_base64 = response.data[0].b64_json\n",
        "edited_bytes = base64.b64decode(edited_base64)\n",
        "edited_image = Image.open(io.BytesIO(edited_bytes))\n",
        "\n",
        "edited_image.save(\"edited_image.png\")\n",
        "edited_image"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Streamlitアプリを作成"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "%%writefile app.py\n",
        "import os\n",
        "import io\n",
        "import base64\n",
        "from openai import OpenAI\n",
        "import streamlit as st\n",
        "from PIL import Image\n",
        "\n",
        "st.set_page_config(page_title=\"GPTimage1.5 Demo\", layout=\"centered\")\n",
        "\n",
        "api_key = os.environ.get(\"OPENAI_API_KEY\")\n",
        "if not api_key:\n",
        "    st.error(\"OPENAI_API_KEY が設定されていません。\")\n",
        "    st.stop()\n",
        "\n",
        "client = OpenAI(api_key=api_key)\n",
        "\n",
        "st.title(\"画像を生成するボット（GPTimage1.5）\")\n",
        "user_input = st.text_input(\"生成したい画像の説明を入力してください:\", \"a futuristic city at sunset\")\n",
        "size = st.selectbox(\"画像サイズ\", [\"1024x1024\", \"1024x1536\", \"1536x1024\"], index=0)\n",
        "\n",
        "if st.button(\"画像生成\"):\n",
        "    with st.spinner(\"生成中...\"):\n",
        "        response = client.images.generate(\n",
        "            model=\"gpt-image-1.5\",\n",
        "            prompt=user_input,\n",
        "            size=size,\n",
        "        )\n",
        "\n",
        "        image_base64 = response.data[0].b64_json\n",
        "        image_bytes = base64.b64decode(image_base64)\n",
        "        image = Image.open(io.BytesIO(image_bytes))\n",
        "\n",
        "    st.success(\"画像を生成しました\")\n",
        "    st.image(image, caption=\"Created by GPTimage1.5\", use_container_width=True)\n",
        "\n",
        "    buf = io.BytesIO()\n",
        "    image.save(buf, format=\"PNG\")\n",
        "    st.download_button(\n",
        "        label=\"PNGをダウンロード\",\n",
        "        data=buf.getvalue(),\n",
        "        file_name=\"generated_image.png\",\n",
        "        mime=\"image/png\",\n",
        "    )"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. StreamlitをColab上で公開"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "!streamlit run app.py \\\n",
        "  --server.port 8501 \\\n",
        "  --server.address 0.0.0.0 \\\n",
        "  --server.headless true \\\n",
        "  --server.enableCORS false \\\n",
        "  --server.enableXsrfProtection false \\\n",
        "  --server.fileWatcherType none \\\n",
        "  > /tmp/st.log 2>&1 &\n",
        "\n",
        "!for i in {1..60}; do curl -fsS http://localhost:8501/healthz && echo \"Streamlit is up\" && break || sleep 1; done\n",
        "\n",
        "!cloudflared tunnel --url http://localhost:8501 --no-autoupdate > /tmp/cf.log 2>&1 &\n",
        "\n",
        "!for i in {1..60}; do \\\n",
        "  URL=$(grep -o \"https://[0-9a-z.-]*trycloudflare.com\" -m 1 /tmp/cf.log); \\\n",
        "  if [ -n \"$URL\" ]; then echo \"PUBLIC URL: $URL\"; break; fi; \\\n",
        "  sleep 1; \\\n",
        "done"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 7. 補足\n",
        "\n",
        "- `gpt-image-1.5` はレスポンスで画像URLではなく `b64_json` を返します。\n",
        "- そのため、`requests.get(...)` は不要です。\n",
        "- APIキーはコードに直書きせず、環境変数 `OPENAI_API_KEY` を使う構成にしています。"
      ]
    }
  ],
